---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
  {% if page.url and page.url != '/404.html' and page.url contains '.html' or page.url == '/' or page.url contains '/zh/' %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{% if page.url == '/' %}1.0{% elsif page.url contains '/zh/' %}0.8{% else %}0.9{% endif %}</priority>
  </url>
  {% endif %}
  {% endfor %}
  {% for article in site.knowledge %}
  <url>
    <loc>{{ site.url }}{{ article.url }}</loc>
    <lastmod>{{ article.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
  {% for demo in site.demos %}
  <url>
    <loc>{{ site.url }}{{ demo.url }}</loc>
    <lastmod>{{ demo.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
</urlset>
